# Sieht nach, ob gerade Wartungsfenster ist.
#
# Diese Datei ist eine Vorlage. dienst.sh setzt den Platzhalter und
# legt das Ergebnis in /etc/systemd/system/devarenu-fenster.service ab.
#
# Ist in netz.json kein Fenster eingeschaltet -- die Vorgabe --, endet
# der Lauf nach Millisekunden und sagt nichts. Deshalb darf der Timer
# daneben ruhig alle fuenf Minuten ticken.

[Unit]
Description=Devarenu, Wartungsfenster pruefen
Documentation=https://github.com/Auroramomo/Devarenu
# Ohne NetworkManager gibt es nichts zu verbinden.
After=NetworkManager.service

[Service]
Type=oneshot
# Ueber /bin/bash und nicht direkt: das Ausfuehrungsrecht geht
# verloren, sobald der Ordner ueber einen FAT-Stick oder als ZIP
# kopiert wird. Naeheres in devarenu-update.service.vorlage.
ExecStart=/bin/bash @ORDNER@/wartungsfenster.sh --pruefen

# KEINE ZEITGRENZE (29.10.2026). Ausserhalb des Fensters endet der Lauf
# nach Millisekunden; im Fenster spielt er aber das Autoupdate ein, und
# zwar SYNCHRON: wartungsfenster.sh --pruefen -> aktualisieren.sh ->
# aktualisierung.sh, samt Selbsttest und llama-Schritt (bis 50 min). Bis
# hier stand 120 s. Seit 0.5.2 laeuft das Update als root und kommt weit
# genug, dass systemd es mittendrin beendet haette -- ohne Ruecksprung.
#
# Synchron und nicht als eigene Unit: so lange das Update laeuft, startet
# der Timer diesen Dienst nicht noch einmal, und niemand trennt das WLAN
# oder schaltet den Rechner aus, solange noch geladen wird. Die Grenzen
# stehen in den Schritten selbst (llama_einrichten.py --frist, timeout).
# (pruefstand/update_zeitgrenzen_test.sh)
TimeoutStartSec=infinity

# EIN $HOME, obwohl dieser Dienst keines braeuchte.
#
# Im Fenster laeuft das Autoupdate, und dazu gehoert der
# Gesundheitscheck. Der fragt ueber systemcheck.py die
# Energieeinstellungen bei kreadconfig6 ab -- und das loest ohne HOME
# "$HOME/.config" zu "//.config" auf, beschwert sich darueber auf dem
# Terminal und schrieb jede Woche zwei nutzlose Zeilen ins Journal:
#
#   Configuration file "//.config/kreadconfig6rc" not writable.
#
# systemcheck.py setzt seit 0.4.0 selbst ein HOME ein, wenn keines
# steht. Hier steht es trotzdem, aus demselben Grund wie in
# devarenu-update.service: ein Programm, das $HOME erwartet und keines
# findet, bricht im schlechteren Fall ab statt sich zu beschweren.
Environment=HOME=/root

StandardOutput=journal
StandardError=journal
