# Devarenu als Systemdienst.
#
# Diese Datei ist eine Vorlage. dienst.sh setzt die Platzhalter auf die
# Werte dieses Rechners und legt das Ergebnis in
# /etc/systemd/system/devarenu.service ab. Von Hand bearbeitet gehoert
# dort die fertige Datei, nicht diese.
#
# System-Unit mit User= und nicht Nutzer-Unit, aus zwei Gruenden:
#
#   Eine Nutzer-Unit kann nicht gegen eine System-Unit ordnen. Ollama
#   laeuft als System-Dienst; die Abhaengigkeit unten waere aus einer
#   Nutzer-Unit heraus nicht ausdrueckbar.
#
#   Headless ohne Anmeldung braucht eine Nutzer-Unit zwingend
#   "loginctl enable-linger". Das geht, ist aber eine Bedingung mehr, und
#   ihr Fehlen zeigt sich als "Dienst startet nicht", ohne zu sagen warum.
#
# Der Server spricht ueber PortAudio direkt ALSA an (hw:X,Y). Ohne
# Sitzung faellt der Zugriff ueber die uaccess-ACL weg, deshalb
# SupplementaryGroups=audio -- so haengt es nicht daran, ob jemand
# usermod ausgefuehrt und sich neu angemeldet hat.
#
# ACHTUNG, hier stand frueher "PipeWire wird nicht gebraucht". Das gilt
# so nicht mehr. Auf Ubuntu 26.04 ist PortAudio MIT Pulse-Backend
# gebaut, und Pa_Initialize versucht das zuerst. Ohne angemeldete
# Sitzung gibt es keinen PulseAudio-Server, und der Import von
# sounddevice bricht ab, bevor ALSA ueberhaupt drankommt:
#
#     PulseAudio_Initialize: Can't connect to server
#
# Der Server ueberlebt das seit 0.2.9 -- er laeuft ohne Tonquelle
# weiter, statt den Dienst in eine Neustartschleife zu schicken. Ton
# gibt es dadurch aber nicht.
#
# PULSE_SERVER auf einen leeren Wert bringt PortAudio dazu, das
# Pulse-Backend zu ueberspringen und ALSA zu nehmen. Gemessen ist das
# NOCH NICHT -- auf dem Entwicklungsrechner laeuft eine Sitzung, dort
# faellt der Fall nicht an. Wer den Gemeinderechner aufstellt: erst
# ./pruefen.sh, Abschnitt Ton. Steht dort "PortAudio laedt nicht",
# diese Zeile einkommentieren und den Dienst neu starten.
#Environment=PULSE_SERVER=

[Unit]
Description=Devarenu, Live-Uebersetzung im Gottesdienst
Documentation=https://github.com/Auroramomo/Devarenu
# Ollama muss vorher laufen, sonst scheitert die erste Uebersetzung.
# Ordnen allein genuegt nicht: systemd haelt eine Type=simple-Unit fuer
# gestartet, sobald der Prozess laeuft, nicht wenn die Schnittstelle
# antwortet. Deshalb wartet server.py zusaetzlich selbst.
#
# network-online.target steht hier, hilft der Adressanzeige aber nicht,
# und das ist gemessen, nicht vermutet. Bei einem Kaltstart:
#
#   08:24:48.56  NetworkManager meldet "startup complete" -- aktiviert
#                ist zu dem Zeitpunkt nur loopback
#   08:24:48     NetworkManager-wait-online startet UND endet in
#                derselben Sekunde, mit Erfolg
#   08:24:48     network-online.target erreicht, devarenu startet
#   08:24:50     erst jetzt meldet sich die Netzwerkkarte an
#   08:24:56     Adresse per DHCP da
#
# Das Target bedeutet "NetworkManager hat nichts mehr vor", nicht "es
# gibt eine Adresse". Es wartete null Sekunden, weil zu dem Zeitpunkt
# kein Geraet bekannt war, auf das es haette warten koennen.
#
# Frueher aufhaengen waere der falsche Handel: bis zu 45 Sekunden
# Startverzoegerung (DHCP-Frist) fuer eine Anzeigezeile, obwohl der
# Server das Netz zum Starten gar nicht braucht -- er bindet auf
# 0.0.0.0 und antwortet ab der ersten Sekunde. Deshalb sucht server.py
# die Adresse stattdessen selbst weiter und traegt sie nach.
After=network-online.target ollama.service
Wants=network-online.target ollama.service

# Gehoert hierher und nicht zu [Service]: dort nimmt systemd den
# Schluessel still nicht an. Ohne ihn gibt es nach fuenf schnellen
# Fehlstarts endgueltig auf. Im Gemeindesaal ist Weiterprobieren besser --
# ein Mikrofon, das erst mit der Tonanlage auftaucht, waere sonst ein Fall
# fuer einen Handgriff, den am Sabbat niemand kennt.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@BENUTZER@
SupplementaryGroups=audio
WorkingDirectory=@ORDNER@
# -u, weil die Ausgabe ins Journal geht. Ohne das puffert Python
# blockweise, und beim Absturz ist genau die letzte Meldung verloren.
ExecStart=@ORDNER@/.venv/bin/python -u @ORDNER@/server.py --port @PORT@

# KEIN --geraet und kein --mikro. Die Tonquelle steht in zustand.json und
# wird am Pult gewaehlt. Stuende sie hier, wuerde der Dienst die Auswahl
# aus der Oberflaeche bei jedem Neustart still ueberstimmen.

# Port 80 ohne Wurzelrechte. Gebraucht nur, wenn dieser Rechner das
# Saalnetz selbst stellt: die Pruefadressen der Hersteller fragen
# ausschliesslich Port 80, und ein Handy, das "10.0.0.1" eintippt,
# meint auch Port 80. Der Dienst bleibt dabei ein gewoehnlicher
# Benutzerprozess -- er bekommt genau das Recht, eine Portnummer unter
# 1024 zu belegen, und sonst keines.
#
# NoNewPrivileges verhindert, dass aus dieser einen Faehigkeit mehr
# wird: kein setuid-Programm kann daraus Rechte gewinnen.
#
# Steht die Zeile nicht da, faellt der Server auf Port 8000 zurueck und
# sagt es in der Startausgabe. Ausfall ist das keiner -- aber die
# Handys melden dann "kein Internet".
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Restart=always
RestartSec=10

# Bewusst ohne Haertung. PrivateDevices, ProtectHome oder DeviceAllow
# nehmen /dev/snd oder /dev/nvidia* weg, und das Fehlerbild ist dasselbe
# wie bei der fehlenden libcublas: laeuft scheinbar, liefert nichts.

[Install]
WantedBy=multi-user.target
