# Was hier steht, gehoert nicht ins Repo: entweder weil es beim Einrichten
# neu entsteht, oder weil es pro Rechner verschieden ist.

# Python-Umgebung und Zwischenstaende
.venv/
__pycache__/
*.pyc

# Wird von einrichten.sh geladen, zusammen mehrere Gigabyte
models/
voices/

# Laufzeitdaten
ergebnisse/
zustand.json

# Aufnahmen und Testtoene. predigt.mp3 ist die Testdatei, sie ist eine
# echte Predigt und hat im Repo nichts verloren.
*.mp3
*.wav
*.m4a
*.flac

# Betriebssystem
.DS_Store
Thumbs.db

# Was das Update per USB-Stick auf der Platte ablegt: Bundle, Wheels und
# die Statusdatei, die das Pult anzeigt. Gehoert dem Rechner, nicht dem
# Repo -- und muss hier stehen bleiben: ohne diese Zeile meldet
# pruefen.sh eine schmutzige Arbeitskopie und aktualisieren.sh bricht ab.
update/
zustand.json*

# Die erzeugten Pruefpakete. Die Quellen daneben -- Glossar, Satzauswahl,
# Vorlage -- gehoeren ins Repo, die Pakete nicht: sie sind daraus jederzeit
# neu zu bauen, und sie sind gross. Ein Paket sind rund 9 MB Ton, und das
# Repo geht per "git bundle --all" auf jeden Update-Stick. Was hier einmal
# drin ist, traegt jede Gemeinde fuer immer mit.
pruefung/paket_*

# Ausgaben von tondiagnose.sh. Sie gehoeren zu genau einem Rechner und
# genau einem Zeitpunkt -- im Repo waeren sie Ballast, der aelter wird.
tonbericht*.txt

# Der Netzzustand dieses einen Rechners: Router ja/nein, Adresse,
# Schnittstelle, und welche Rechnernamen ueberhaupt umgebaut werden
# duerfen. Gehoert nicht ins Repo -- und darf auch nicht hinein: eine
# Erlaubnisliste, die mitgeliefert wird, waere auf jedem Klon gueltig.
netz.json
netz.json.*

# Bau-venv fuer die Anleitung (Punkt 16). Nur auf dem Arbeitsrechner,
# nie auf dem Gemeinderechner: dort wird das fertige PDF ausgeliefert.
.bau-venv/

# Zwischendateien: Vorschaubilder, Probelaeufe, alles Fluechtige.
# Liegt im Repo, damit es ohne Umweg lesbar ist -- und wird nie
# mitgeliefert.
.tmp/
