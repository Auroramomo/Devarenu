# Spielt ein vorgemerktes Update ein, sobald es ruhig ist.
#
# Diese Datei ist eine Vorlage. dienst.sh setzt den Platzhalter und legt
# das Ergebnis in /etc/systemd/system/devarenu-update.service ab.
#
# Liegt nichts vor, endet der Lauf nach Millisekunden. Deshalb darf der
# Timer daneben ruhig jede Minute ticken.

[Unit]
Description=Devarenu, vorgemerktes Update einspielen
Documentation=https://github.com/Auroramomo/Devarenu

[Service]
Type=oneshot
# Ueber /bin/bash und nicht direkt: das Ausfuehrungsrecht geht
# verloren, sobald der Ordner ueber einen FAT-Stick oder als ZIP
# kopiert wird. Ein Dienst, der daran scheitert, meldet nur
# "Permission denied" -- und niemand sucht dann beim chmod.
ExecStart=/bin/bash @ORDNER@/stick_update.sh --einspielen

# Diese Unit laeuft als root und hat kein User=. systemd setzt dann
# KEIN $HOME, und Programme, die eines erwarten, brechen ab -- ollama
# etwa mit "panic: $HOME is not defined", bevor es ueberhaupt den
# Dienst fragt. Am 27.09. wurde daraus am Pult "das Sprachmodell liegt
# hier nicht", auf einem Rechner, auf dem es lag.
#
# Die Modellpruefung geht seit 0.3.2 ueber HTTP und braucht das nicht
# mehr. Die Zeile bleibt trotzdem: sie kostet nichts, und der
# naechste, der hier ein Kommando einbaut, verliert damit nicht
# dieselbe Stunde.
Environment=HOME=/root

# KEINE ZEITGRENZE (29.10.2026). Hier stecken ein pip-Lauf, ein
# Dienstneustart mit 120 Sekunden Gesundheitspruefung, der Selbsttest,
# seit 0.5.2 der llama-Schritt (bis 50 min, die CUDA-Laufzeit kommt nie
# vom oeffentlichen Stick) und, wenn etwas scheitert, der Rueckweg. Die
# 900 s bis hier haetten das Update mittendrin beendet, ohne Ruecksprung.
# (pruefstand/update_zeitgrenzen_test.sh)
TimeoutStartSec=infinity

StandardOutput=journal
StandardError=journal
