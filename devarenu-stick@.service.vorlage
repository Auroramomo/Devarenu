# Wertet einen eingesteckten USB-Stick aus. Angestossen von der
# udev-Regel, ein Aufruf je Partition.
#
# Diese Datei ist eine Vorlage. dienst.sh setzt den Platzhalter und legt
# das Ergebnis in /etc/systemd/system/devarenu-stick@.service ab.
#
# Der Lauf ist kurz: einhaengen, kopieren, aushaengen, Signatur pruefen,
# vormerken. Eingespielt wird hier nichts -- das macht devarenu-update
# spaeter, wenn der Gottesdienst vorbei ist. Wuerde diese Unit warten,
# waere sie beim naechsten Ausschalten weg, und das fertige Paket laege
# ungenutzt auf der Platte.
#
# Laeuft als root, weil Einhaengen root braucht. Alles, was den
# Projektordner anfasst, stuft stick_update.sh selbst auf den Besitzer
# des Ordners zurueck.

[Unit]
Description=Devarenu, USB-Stick auf ein Update pruefen (%i)
Documentation=https://github.com/Auroramomo/Devarenu

[Service]
Type=oneshot
# Ueber /bin/bash, siehe devarenu-update.service.vorlage.
ExecStart=/bin/bash @ORDNER@/stick_update.sh --lesen /dev/%i

# KEINE ZEITGRENZE (29.10.2026). Bis hier stand 300 s. Ein Stick mit
# allen grossen Teilen traegt rund 19 GB, ein ZIP wird zuerst ausgepackt
# -- an einem langsamen USB-Anschluss dauert allein das Kopieren
# laenger, und systemd haette mittendrin abgebrochen. Ein Stick, der
# beim Lesen abgezogen wird, haengt nicht, sondern liefert Lesefehler,
# und stick_update.sh bricht daran selbst ab.
# (pruefstand/update_zeitgrenzen_test.sh)
TimeoutStartSec=infinity

# Ein Stick, der nichts fuer uns hat, ist der Normalfall und kein Fehler.
# stick_update.sh endet dann mit 0; was hier als Fehler im Journal
# auftaucht, ist wirklich einer.
StandardOutput=journal
StandardError=journal
